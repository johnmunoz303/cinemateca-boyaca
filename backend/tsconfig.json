{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "payu-test-build/types/**/*.ts",
    "payu-test-build/dev/types/**/*.ts",
    "e2e-build/types/**/*.ts",
    "e2e-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e-build",
    "payu-test-build",
    "build-validation-payu",
    "build-payu-final",
    "build-organizacion",
    "build-organizacion-verificado"
  ]
}
